imp: random
imp: string
imp: array

var: game = true

# secret word selection
var: wordBank = ['dog', 'cat', 'paddle', 'car', 'bike', 'motor']
var: secretWord = random.choice(wordBank)
var: letters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z']

# game start
var: secretWordLength = string.len(secretWord)

# print secret word to user
out: 'the secret word is {secretWordLength} characters long'

# turns start
var: guessed array[string] = []

while: == game true
      
      var: display = ' '
      var: i = 0
      var: maxWrongGuesses = 6
      var: wrongGuesses = 0
      var: guess = in: 'input 1 letter: '
      if: != string.len(guess) 1                               
            out: 'guess must be a single letter'
      else: 
            if: array.contains(guessed, guess)
                  out: 'you already guessed that'
            else: 
                  if: string.contains(secretWord, guess)
                        out: 'CORRECT! "{guess}" is in the secret word'
                        guessed = array.push(guessed, guess)
                  else: != string.contains(secretWord, guess)
                        out: 'WRONG! "{guess}" is not in the secret word'
                        guessed = array.push(guessed, guess)
                        wrongGuesses = + wrongGuesses 1
                              if: == maxGuesses maxWrongGuesses
                                    var: == game false
      while: < i string.len(secretWord)
            var: currentLetter = string.at(secretWord, i)
            var: revealedLetter = array.contains(guessed, currentLetter)
            if: == revealedLetter true
                  display = string.concat(display, currentLetter)
            else:
                  display = string.concat(display, '_')
                  if: != display '_' 
                       #  var: game = false
            display = string.concat(display, ' ')
            i = + i 1
      out: display
