imp: math_extra
imp: string
imp: array
imp: random
imp: testing
test: 'stdlib assert stays compatible'
    var: letters array[string] = []
    var: choices = ['stable']
    letters = array.push(letters, 'w')
    assert: testing.assert(== string.len('walk') 4)
    assert: == string.at('walk', 0) 'w'
    assert: string.contains('walk', 'al')
    assert: == string.concat('walk', 'lang') 'walklang'
    assert: array.contains(letters, 'w')
    assert: == random.choice(choices) 'stable'
test: 'module export stays compatible'
    assert: == math_extra.cube(3) 27
