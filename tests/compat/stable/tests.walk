imp: math_extra
imp: math
imp: string
imp: array
imp: random
imp: testing
test: 'stdlib assert stays compatible'
    var: letters array[string] = []
    var: choices = ['stable']
    var: word = 'walk'
    var: wordLength = string.len(word)
    letters = array.push(letters, 'w')
    assert: testing.assert(== string.len('walk') 4)
    assert: == string.at('walk', 0) 'w'
    assert: string.contains('walk', 'al')
    assert: == string.concat('walk', 'lang') 'walklang'
    assert: == string.lower('Hi WALK') 'hi walk'
    var: parts = string.split('a b', ' ')
    assert: == parts[0] 'a'
    assert: == parts[1] 'b'
    assert: == string.replace('banana', 'na', 'NA') 'baNANA'
    assert: == string.slice('walklang', 4, 99) 'lang'
    assert: == string.prefix('walklang', 4) 'walk'
    assert: array.contains(letters, 'w')
    assert: == random.choice(choices) 'stable'
    assert: == math.exp(0) 1
    assert: == math.log(1) 0
    assert: == math.remainder(35, 11) 2
    assert: == math.remainder(-35, 11) -2
    assert: == random.float(4, 4) 4
    assert: == random.float(5, 2) 5
    assert: == 'length {wordLength}' 'length 4'
    assert: == 'plural {string.concat(word, 's')}' 'plural walks'
test: 'module export stays compatible'
    assert: == math_extra.cube(3) 27
