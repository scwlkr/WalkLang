imp: math_extra
imp: math
imp: string
imp: array
imp: random
imp: testing
func: add(a int, b int) int
    return: + a b
func: inc(x int) int
    return: + x 1
func: apply(f func(int) int, x int) int
    return: f(x)
var: nums = [1, 2, 3]
nums[1] = 9
var: letters array[string] = []
var: choices = ['stable']
letters = array.push(letters, 'W')
var: word = 'walk'
var: wordLength = string.len(word)
var: stableParts = string.split('a b', ' ')
out: math_extra.cube(3)
out: add(2, 3)
out: math.sqrt(9)
out: math.pow(2, 3)
out: math.exp(0)
out: math.log(1)
out: string.len('walk')
out: string.at('walk', 1)
out: 'walk'[2]
out: string.contains('walk', 'al')
out: string.concat('walk', 'lang')
out: string.lower('Hi WALK')
out: stableParts[0]
out: stableParts[1]
out: string.replace('banana', 'na', 'NA')
out: string.slice('walklang', 4, 99)
out: string.prefix('walklang', 4)
out: array.len(nums)
out: array.len(letters)
out: array.contains(letters, 'W')
out: random.int(7, 7)
out: random.int(10, 1)
out: random.float(4, 4)
out: random.float(5, 2)
out: random.choice(choices)
out: testing.assert(true)
out: 'length {wordLength}'
out: '{{stable}}'
for: n in nums
    out: n
var: count = 0
while: < count 3
    count = + count 1
    if: == count 2
        continue:
    out: count
repeat: 2
    out: 'r'
var: name string? = null
if: == name null
    out: 'missing'
name = 'Walker'
if: != name null
    out: name
out: apply(inc, 4)
