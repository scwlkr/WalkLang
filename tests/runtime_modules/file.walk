imp: array
imp: file
imp: path
imp: string

var: note = path.join('tests/conformance/tmp', 'runtime-module-file.txt')
do: file.write(note, 'alpha')
do: file.append(note, ' beta')
out: file.exists(note)
out: file.read(note)
var: read = file.try_read(note)
out: read.ok
out: read.value
out: read.error
var: missing = file.try_read(path.join('tests/conformance/tmp', 'missing-runtime-module-file.txt'))
out: missing.ok
out: missing.value
out: missing.error
var: bad_write = file.try_write('', 'nope')
out: bad_write.ok
out: bad_write.value
out: bad_write.error

var: chunks array[string] = []
chunks = array.push(chunks, 'walk')
chunks = array.push(chunks, 'lang')
chunks = array.push(chunks, 'chunks')
out: string.join(chunks, '::')

var: chunked = path.join('tests/conformance/tmp', 'runtime-module-file-chunks.txt')
do: file.write_chunks(chunked, chunks)
var: suffix array[string] = []
suffix = array.push(suffix, '!')
do: file.append_chunks(chunked, suffix)
out: file.read(chunked)
