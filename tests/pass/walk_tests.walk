imp: math
imp: string
imp: array
imp: random
imp: testing
func: add(a int, b int) int
    return: + a b
test: 'arithmetic works'
    assert: == add(2, 3) 5
test: 'stdlib works'
    var: nums = [1, 2, 3]
    var: letters array[string] = []
    var: choices = ['only']
    letters = array.push(letters, 'w')
    var: fixed_random = random.int(2, 2)
    assert: == array.len(nums) 3
    assert: == array.len(letters) 1
    assert: array.contains(letters, 'w')
    assert: == string.len('walk') 4
    assert: == string.at('walk', 0) 'w'
    assert: == 'walk'[1] 'a'
    assert: string.contains('walk', 'al')
    assert: == string.concat('walk', 'lang') 'walklang'
    assert: == string.lower('Hi WALK') 'hi walk'
    var: parts = string.split('a b', ' ')
    assert: == parts[0] 'a'
    assert: == parts[1] 'b'
    assert: == string.replace('banana', 'na', 'NA') 'baNANA'
    assert: == string.slice('walklang', 4, 4) 'lang'
    assert: == string.slice('walklang', 4, 99) 'lang'
    assert: == string.slice('walklang', 99, 4) ''
    assert: == string.slice('', 0, 4) ''
    assert: == string.prefix('walklang', 4) 'walk'
    assert: == string.prefix('walklang', 99) 'walklang'
    assert: == string.prefix('', 4) ''
    assert: == random.choice(choices) 'only'
    assert: == math.exp(0) 1
    assert: == math.log(1) 0
    assert: == math.pow(2, 3) 8
    assert: == random.float(4, 4) 4
    assert: == random.float(5, 2) 5
    assert: testing.assert(== fixed_random 2)

test: 'random float stays bounded and varies'
    var: first = random.float(0, 1)
    var: changed = false
    assert: >= first 0
    assert: < first 1
    repeat: 64
        var: sample = random.float(0, 1)
        assert: >= sample 0
        assert: < sample 1
        if: != sample first
            changed = true
    assert: changed
