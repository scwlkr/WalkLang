/// Summary: Cubes an integer.
/// Params:
/// - x: value to multiply by itself twice
/// Returns: the cubed value.
/// Example:
/// ```walk
/// out: cube(3)
/// ```
/// Since: current
func: cube(x int) int
    return: * x x x

/// Summary: Increments an integer by one.
/// Params:
/// - x: value to increment
/// Returns: the incremented value.
/// Example:
/// ```walk
/// out: bump(4)
/// ```
/// Since: current
func: bump(x int) int
    return: + x 1

/// Summary: Exposes cube from the math_extra example module.
/// Example:
/// ```walk
/// exp: cube
/// ```
/// Since: current
exp: cube
